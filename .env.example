# Kopier til .env og fyll inn. .env skal aldri committes.
# Verdiene er ikke hemmelige, men legges som miljøvariabler i Bolt og Netlify.
VITE_SANITY_PROJECT_ID=dzgfs6fk
VITE_SANITY_DATASET=production

# Utleieskjemaet (Netlify-funksjonen netlify/functions/utleie-foresporsel.mts).
# Disse ER hemmelige: legges bare inn i Netlify som «Secret», aldri her eller i koden.
# Navnene må IKKE starte med VITE_, ellers havner de i nettleseren. Se docs/utleie.md.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
APPS_SCRIPT_URL=
APPS_SCRIPT_SECRET=
